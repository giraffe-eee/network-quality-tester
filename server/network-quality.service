[Unit]
Description=Network Quality Measurement Endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nqtester
Group=nqtester
WorkingDirectory=/opt/network-quality-tester
EnvironmentFile=-/etc/network-quality-tester.conf
ExecStart=/usr/bin/python3 /opt/network-quality-tester/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
